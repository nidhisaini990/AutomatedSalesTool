# SQLite is used by default. Use the Compose value below for PostgreSQL.
DATABASE_URL=sqlite:///./sales_agent.db
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-value-before-production
JWT_EXPIRE_MINUTES=480
EMAIL_SENDING_ENABLED=false
CORS_ORIGINS=http://localhost:3000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
POSTGRES_DB=sales_agent
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=localdev-only
